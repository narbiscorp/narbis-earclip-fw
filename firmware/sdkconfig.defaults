# Narbis Edge Earclip — build defaults (ESP-IDF v5.5.x, esp32c6)

# --- Bluetooth: NimBLE peripheral only ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Controller sleep: without this the BLE controller holds a CPU_FREQ_MAX
# pm lock forever and DFS/auto-light-sleep never engage (IDLE power target
# unmeetable). LP clock from main XTAL (no external 32k on the XIAO).
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
# bt.c hard-requires MAC/baseband power-down for BLE light sleep
# (depends on tickless idle, which is on below).
CONFIG_ESP_PHY_MAC_BB_PD=y

# --- FreeRTOS / power management ---
CONFIG_FREERTOS_HZ=1000
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# --- Console on USB-Serial-JTAG (the XIAO USB-C) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Flash: XIAO ESP32-C6 has 4 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Partitions / OTA ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Diagnostics ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3
